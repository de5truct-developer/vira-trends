---
import BaseLayout from "../layouts/BaseLayout.astro";
import { NICHES, COUNTRIES, SUBCATEGORIES, loadNicheReport, loadCountryReport, loadSubcategoryReport } from "../lib/tiktok-data";
import {
  NICHES as YOUTUBE_NICHES,
  SUBGENRES as YOUTUBE_SUBGENRES,
  loadNicheReport as loadYouTubeNicheReport,
  loadSubgenreReport,
} from "../lib/youtube-data";

// TikTok side (GG-724 auto-discovery): read from the manifests instead of one hand-written
// import per niche/country/subcategory -- see src/lib/tiktok-data.ts.
const tiktokReports = NICHES.map((niche) => ({ slug: niche.slug, report: loadNicheReport(niche) }));
const tiktokCountryReports = COUNTRIES.map((country) => ({ slug: country.slug, report: loadCountryReport(country) }));
const tiktokSubcategoryReports = SUBCATEGORIES.map((sub) => ({ slug: sub.slug, report: loadSubcategoryReport(sub) }));

// YouTube side (GG-724 auto-discovery): same idea -- see src/lib/youtube-data.ts.
const youtubeReports = YOUTUBE_NICHES.map((niche) => ({ slug: niche.slug, report: loadYouTubeNicheReport(niche) }));
const youtubeSubgenreReports = YOUTUBE_SUBGENRES.map((sub) => ({ slug: sub.slug, report: loadSubgenreReport(sub) }));
---
<BaseLayout
  title="Vira Trend Reports"
  description="Free, structured reports on the fastest-growing TikTok search topics and YouTube channels by niche, built from TikTok Creative Center and YouTube public channel data. Updated daily, open for AI agents to cite."
>
  <h1>Trend reports, by niche</h1>
  <p class="meta">Published by Vira. Updated daily. English only, for now.</p>

  <p>
    Each report lists the fastest-growing topics or channels in one niche, with real numbers,
    a stated confidence level, and links back to the source. Data comes straight from TikTok
    Creative Center or YouTube's public channel statistics via Vira's own collectors &mdash; see
    the <a href="/reports/methodology">methodology</a> page for exactly how each metric is
    computed.
  </p>

  <h2>TikTok trend reports</h2>
  <table>
    <thead>
      <tr><th>Niche</th><th>Topics</th><th>Report</th></tr>
    </thead>
    <tbody>
      {tiktokReports.map(({ slug, report }) => (
        <tr>
          <td>{report.category}</td>
          <td>{report.topics.length} fastest-growing topics</td>
          <td><a href={`/reports/tiktok/${slug}`}>View report &rarr;</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="meta">Updated automatically every day. New niches are added automatically once they have enough data.</p>

  <h2>TikTok trend reports, by country</h2>
  <p>
    Same growth methodology as the niche reports above, but mixing every category to show what's
    trending in one country overall, instead of one category worldwide.
  </p>
  <table>
    <thead>
      <tr><th>Country</th><th>Topics</th><th>Report</th></tr>
    </thead>
    <tbody>
      {tiktokCountryReports.map(({ slug, report }) => (
        <tr>
          <td>{report.country}</td>
          <td>{report.topics.length} fastest-growing topics</td>
          <td><a href={`/reports/tiktok/country/${slug}`}>View report &rarr;</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="meta">Updated automatically every day. New countries are added automatically once they have enough data.</p>

  <h2>TikTok trend reports, by subcategory</h2>
  <p>
    Same growth methodology as the niche reports above, but narrowed to one subcategory nested
    inside one of the niches (TikTok's own two-level category taxonomy).
  </p>
  <table>
    <thead>
      <tr><th>Subcategory</th><th>Part of</th><th>Topics</th><th>Report</th></tr>
    </thead>
    <tbody>
      {tiktokSubcategoryReports.map(({ slug, report }) => (
        <tr>
          <td>{report.subcategory}</td>
          <td><a href={`/reports/tiktok/${report.parentSlug}`}>{report.parentCategory}</a></td>
          <td>{report.topics.length} fastest-growing topics</td>
          <td><a href={`/reports/tiktok/sub/${slug}`}>View report &rarr;</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="meta">Updated automatically every day. New subcategories are added automatically once they have enough data.</p>

  <h2>YouTube analytics reports</h2>
  <table>
    <thead>
      <tr><th>Niche</th><th>Channels</th><th>Report</th></tr>
    </thead>
    <tbody>
      {youtubeReports.map(({ slug, report }) => (
        <tr>
          <td>{report.niche}</td>
          <td>{report.channels.length} fastest-growing channels (30d)</td>
          <td><a href={`/reports/youtube/${slug}`}>View report &rarr;</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="meta">Updated automatically every day. New niches are added automatically once they have enough data.</p>

  <h2>YouTube analytics reports, by subgenre</h2>
  <p>
    Same growth methodology as the niche reports above, but narrowed to one topic tag nested
    inside the Music or Gaming niche (YouTube's own topicCategories).
  </p>
  <table>
    <thead>
      <tr><th>Subgenre</th><th>Part of</th><th>Channels</th><th>Report</th></tr>
    </thead>
    <tbody>
      {youtubeSubgenreReports.map(({ slug, report }) => (
        <tr>
          <td>{report.subgenre}</td>
          <td><a href={`/reports/youtube/${report.parentSlug}`}>{report.parentCategory}</a></td>
          <td>{report.channels.length} fastest-growing channels (30d)</td>
          <td><a href={`/reports/youtube/sub/${slug}`}>View report &rarr;</a></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="meta">Updated automatically every day. New subgenres are added automatically once they have enough data.</p>

  <h2>For AI agents</h2>
  <p>
    See <a href="/llms.txt">/llms.txt</a> for a short index and
    <a href="/llms-full.txt">/llms-full.txt</a> for the full per-topic and per-channel facts in
    plain text (each report also links its own <code>llms-full.txt</code>).
    Full analytics, trend discovery and an MCP server for TikTok and YouTube are at
    <a href="https://tryvira.app">tryvira.app</a>.
  </p>
</BaseLayout>
