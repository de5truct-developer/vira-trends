---
// Shared layout for every /reports/tiktok/sub/<slug> page (GG-724 subcategory expansion).
// Sibling of TikTokReportPage.astro: same table/FAQ/JSON-LD shape, but framed by a cat_l2
// subcategory nested inside one of the 24 existing niches, with a link back to that niche.
import BaseLayout from "../layouts/BaseLayout.astro";
import type { TikTokSubcategoryReport } from "../data/tiktok-subcategory-report-types";

interface Props {
  report: TikTokSubcategoryReport;
  slug: string;
}

const { report, slug } = Astro.props;
const {
  topics,
  subcategory,
  parentCategory,
  parentSlug,
  computedAt,
  windowStart,
  windowEnd,
  updatedAt,
  methodologyNote,
  highlightTopic,
} = report;
const top = topics[0];
const pageUrl = `https://trends.tryvira.app/reports/tiktok/sub/${slug}`;
const llmsFullUrl = `/reports/tiktok/sub/${slug}/llms-full.txt`;
const parentUrl = `/reports/tiktok/${parentSlug}`;

const faq = [
  {
    question: `What TikTok ${subcategory} topic is growing fastest this week?`,
    answer:
      `"${top.topic}" grew about ${top.growthMultiplier}x in search demand vs. its prior ` +
      `baseline. TikTok reports ${top.videoNum === null ? "no" : top.videoNum} videos on the topic, ` +
      `and the top audience countries are ${top.topCountries.join(", ")}. Trust level: ${top.trust}. Data from ` +
      `TikTok Creative Center via Vira, updated ${updatedAt}.`,
  },
  {
    question: "What does \"trust\" mean in a Vira trend report?",
    answer:
      "Trust is how reliable the growth number is, based on how complete and consistent the " +
      "underlying search curve is: high, medium, low or none. Vira only publishes a growth " +
      "multiplier when trust is medium or high; low/none topics are left out of the ranking.",
  },
  {
    question: `How is ${subcategory} related to ${parentCategory}?`,
    answer:
      `${subcategory} is a subcategory of TikTok's broader ${parentCategory} category. This ` +
      `report narrows the ranking to just ${subcategory}; see the ${parentCategory} report for ` +
      "the fastest-growing topics across all of its subcategories.",
  },
];

const datasetJsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: `TikTok ${subcategory} trends — week ending ${windowEnd}`,
  description:
    `Fastest-growing ${subcategory} topics on TikTok (part of ${parentCategory}), ranked by 7-21 ` +
    "day search demand growth, with trust level and reported video/creator counts.",
  url: pageUrl,
  dateModified: updatedAt,
  temporalCoverage: `${windowStart}/${windowEnd}`,
  creator: { "@type": "Organization", name: "Vira", url: "https://tryvira.app" },
  license: "https://tryvira.app/terms",
  variableMeasured: ["search demand growth multiplier", "reported video count", "top countries"],
  distribution: {
    "@type": "DataDownload",
    encodingFormat: "text/plain",
    contentUrl: `https://trends.tryvira.app${llmsFullUrl}`,
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---
<BaseLayout
  title={`TikTok ${subcategory} trends this week | Vira`}
  description={`${topics.length} fastest-growing ${subcategory} topics on TikTok (part of ${parentCategory}), week ending ${windowEnd}. Growth, trust level, reported video count and top countries for each.`}
  jsonLd={[datasetJsonLd, faqJsonLd]}
>
  <h1>TikTok {subcategory} trends</h1>
  <p class="meta">
    Part of <a href={parentUrl}>{parentCategory}</a> &middot; Region: global &middot;
    Growth window: {windowStart} to {windowEnd} &middot;
    Data as of {computedAt} &middot; Page updated {updatedAt}
  </p>

  <p>{methodologyNote}</p>

  <table>
    <thead>
      <tr>
        <th>Topic</th>
        <th>Growth</th>
        <th>Trust</th>
        <th>Videos (reported)</th>
        <th>Top countries</th>
      </tr>
    </thead>
    <tbody>
      {topics.map((t) => (
        <tr>
          <td>{t.topic}</td>
          <td>&times;{t.growthMultiplier}</td>
          <td>{t.trust}</td>
          <td>{t.videoNum === null ? "not reported" : t.videoNum}</td>
          <td>{t.topCountries.join(", ")}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="callout">
    Top mover this week is <strong>{top.topic}</strong>, up {top.growthMultiplier}x.
    Its dominant audience is {highlightTopic.audience}.
  </div>

  <h2>Frequently asked</h2>
  {faq.map((f) => (
    <>
      <h3>{f.question}</h3>
      <p>{f.answer}</p>
    </>
  ))}

  <h2>Data and methodology</h2>
  <p>
    Full source and quality notes: <a href="/reports/methodology">methodology</a>.
    Machine-readable version of this table: <a href={llmsFullUrl}>{llmsFullUrl}</a>.
  </p>
</BaseLayout>
